{
  "description": "RunQuery with explain_options on an Enterprise database",
  "captured": "2026-11-04",
  "rpc": "RunQuery",
  "request": {
    "structuredQuery": {
      "from": [
        {
          "collectionId": "pipeline-books"
        }
      ],
      "where": {
        "fieldFilter": {
          "field": {
            "fieldPath": "genre"
          },
          "op": "EQUAL",
          "value": {
            "stringValue": "Dystopian"
          }
        }
      },
      "orderBy": [
        {
          "field": {
            "fieldPath": "rating"
          },
          "direction": "DESCENDING"
        }
      ]
    },
    "explainOptions": {
      "analyze": true
    }
  },
  "response": [
    {
      "error": {
        "code": 400,
        "message": "Explain options are not supported in RunQuery API for Enterprise edition. Please use the ExecutePipeline API instead.",
        "status": "INVALID_ARGUMENT"
      }
    }
  ]
}
